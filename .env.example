# ===== landlord-counter 配置样例：复制为 .env 后按需修改（.env 不入库）=====

# --- ADB ---
# 多设备时指定云手机/模拟器序列号（adb devices 查看）；单设备可留空
ADB_SERIAL=127.0.0.1:5555

# --- 游戏视觉适配包 ---
# doudizhu_wishday 等，见 src/landlord_counter/profiles.py
GAME_PROFILE=doudizhu_wishday

# --- VLM 识别（模板匹配对重度重叠画面失效时的主链路）---
# 智谱 OpenAI 兼容端点；模型建议 glm-4v-plus（flash 对重度重叠读不准）
VLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
VLM_API_KEY=你的智谱key
VLM_MODEL=glm-4v-plus

# --- 大模型牌型分析（可选，记牌器会多一段"对手分析"）---
# LLM_ENABLED=1
# LLM_API_KEY=你的key
# LLM_API_BASE=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
